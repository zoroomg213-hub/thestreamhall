    <script>
        // Filter Days function
        function filterDays(day) {
            const cards = document.querySelectorAll('.day-card');
            const buttons = document.querySelectorAll('#filter-container button');

            // Reset active button styling
            buttons.forEach(btn => {
                btn.className = "px-3.5 py-1.5 bg-slate-800/80 text-slate-300 hover:bg-slate-700 rounded-xl text-xs font-semibold transition whitespace-nowrap";
            });

            // Highlight selected button
            const activeBtn = document.getElementById('btn-' + day);
            if (activeBtn) {
                activeBtn.className = "px-3.5 py-1.5 bg-indigo-600 text-white rounded-xl text-xs font-semibold transition hover:bg-indigo-500 whitespace-nowrap";
            }

            // Show / Hide cards
            cards.forEach(card => {
                if (day === 'all' || card.getAttribute('data-day') === day) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Add Activity Handler
        function addActivityPrompt(dayName) {
            const title = prompt(`Enter new activity title for ${dayName}:`);
            if (!title) return;
            const time = prompt("Enter time slot (e.g. 18:00 - 19:00):", "18:00 - 19:00");
            const desc = prompt("Enter short description:", "Relaxation time");

            const dayCard = document.querySelector(`.day-card[data-day="${dayName.substring(0,3)}"] .space-y-2\\.5`);
            if (dayCard) {
                const newBlock = document.createElement('div');
                newBlock.className = 'item-bg p-3 rounded-xl border-l-4 border-cyan-500 hover:bg-item-hover transition';
                newBlock.innerHTML = `
                    <div class="flex justify-between items-center text-sm font-semibold">
                        <span class="flex items-center gap-2 text-slate-200"><i class="fa-solid fa-star text-cyan-400"></i> ${title}</span>
                        <span class="bg-slate-900/80 text-xs text-slate-400 px-2 py-0.5 rounded font-mono">${time || 'TBD'}</span>
                    </div>
                    <p class="text-xs text-slate-400 mt-1">${desc || ''}</p>
                `;
                dayCard.appendChild(newBlock);
            }
        }
    </script>
